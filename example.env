# Server Configuration
PORT=4000

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=secret
DB_NAME=trankyou_main

# API Keys (comma-separated)
API_KEYS=TRANKYOU_KEY,GATEDISTRO_KEY

# AWS S3 Configuration (required for AudioSalad ingest uploads)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
S3_INGEST_BUCKET=your-ingest-bucket
S3_INGEST_BASE_PATH=ddex-releases
AUDIOSALAD_DISTRIBUTOR_NAME=TrankSonic

